{
  "rules": {
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['name','ts'])",
        "name": { ".validate": "newData.isString() && newData.val().length <= 24" },
        "$other": { ".validate": true }
      }
    },
    "invites": {
      "$to": {
        ".read": "auth != null && auth.uid === $to",
        "$id": {
          ".write": "auth != null && (auth.uid === $to || newData.child('from').val() === auth.uid || data.child('from').val() === auth.uid)"
        }
      }
    },
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        "players": {
          "$p": {
            ".write": "auth != null && auth.uid === $p",
            "name": { ".validate": "newData.isString() && newData.val().length <= 24" }
          }
        }
      }
    }
  }
}
